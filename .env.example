# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5003

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/hireflow

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex_access_secret_change_me_now_please_xx
JWT_REFRESH_SECRET=replace_with_64_char_hex_refresh_secret_change_me_now_pleasex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (optional) ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── Frontend / CORS ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Encryption ───────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Email (optional in local dev) ────────────────────────────────────────
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="HireFlow <noreply@hireflow.ai>"

# ── Kloudbean S3 ─────────────────────────────────────────────────────────
KLOUDBEAN_S3_ENDPOINT=https://s3-object-storage.kloudbeansite.com
KLOUDBEAN_S3_REGION=auto
KLOUDBEAN_S3_BUCKET=hireflow-prod
KLOUDBEAN_S3_ACCESS_KEY_ID=replace_me
KLOUDBEAN_S3_SECRET_ACCESS_KEY=replace_me
KLOUDBEAN_S3_FORCE_PATH_STYLE=true
KLOUDBEAN_S3_PUBLIC_BASE_URL=

# ── AI / Noirly (optional — AI vacancy requires NOIRLY_API_KEY) ───────────
# https://noirly.ai/docs#quickstart
# NOIRLY_API_KEY=sk_...
# NOIRLY_BASE_URL=https://noirly.ai
# NOIRLY_DEFAULT_MODEL=gpt-5.6-sol
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# ── Limits ───────────────────────────────────────────────────────────────
MAX_RESUME_BYTES=10485760
MAX_IMAGE_BYTES=5242880

# ── Sentry (optional) ────────────────────────────────────────────────────
# SENTRY_DSN=
